{
  "name": "cryptstats",
  "version": "1.2.0",
  "description": "CryptStats – Projekte als Krypto-Aktien. Meilensteine treiben den Kurs.",
  "type": "module",
  "private": true,
  "license": "MIT",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "test": "node --test",
    "typecheck": "tsc --noEmit",
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "db:migrate:local": "wrangler d1 migrations apply cryptstats --local",
    "db:migrate": "wrangler d1 migrations apply cryptstats --remote",
    "start": "node src/server.js",
    "dev:node": "node --watch src/server.js"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "typescript": "^5.9.3",
    "wrangler": "^4.151.1"
  }
}
